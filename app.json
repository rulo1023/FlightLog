{
  "expo": {
    "name": "FlightLog",
    "slug": "flightlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "flightlog",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.rulo1023.flightlog",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#087BCB"
      }
    },
    "plugins": [
      "expo-dev-client",
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "icon": "./icon.png",
    "extra": {
      "eas": {
        "projectId": "1e54c537-639a-4749-97f0-533725e5d233"
      }
    }
  }
}
